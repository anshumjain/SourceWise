# PostgreSQL (required). Use Neon/Supabase for local + Vercel.
# Example: postgresql://user:password@host/db?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Neon/Vercel: unpooled host for migrations (often same user/pass, host without "-pooler")
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Set to true to skip RSS/API fetching and use mock articles
USE_MOCK_NEWS=false

# Optional: NewsAPI.org fallback (https://newsapi.org)
NEWS_API_KEY=

# Optional: OpenAI for neutral summarization when RSS description is too short
OPENAI_API_KEY=

# Secret for Vercel Cron / manual cron trigger
CRON_SECRET=change-me-in-production

# Salt for hashing voter IP addresses (bot mitigation)
VOTE_IP_SALT=change-me-in-production

# Public site URL for share links and OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
